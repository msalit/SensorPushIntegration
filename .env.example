# Copy this file to .env and fill in real values. .env is gitignored.

# SensorPush API credentials (your SensorPush account email/password)
SENSORPUSH_EMAIL=you@example.com
SENSORPUSH_PASSWORD=your-sensorpush-password

# OAuth credentials shared with Google Smart Home (Cloud-to-cloud integration)
OAUTH_CLIENT_ID=sensorpush-google-home
OAUTH_CLIENT_SECRET=generate-a-long-random-string

# Cloudflare API token used by the cloudflare-ddns containers.
# Needs DNS:Edit on the target zone (e.g. dogpose.com).
CF_API_TOKEN=your-cloudflare-api-token
